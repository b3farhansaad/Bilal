<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title><%= title || 'خطأ' %></title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Cairo',sans-serif;background:#0d0f1a;color:#fff;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px}
.err-card{text-align:center;max-width:400px}
.err-code{font-size:5rem;font-weight:800;background:linear-gradient(135deg,#5865F2,#ed4245);-webkit-background-clip:text;-webkit-text-fill-color:transparent;line-height:1}
.err-title{font-size:1.4rem;font-weight:700;margin:16px 0 8px}
.err-msg{color:#8a8f9e;font-size:.9rem;margin-bottom:24px}
.btn{display:inline-flex;align-items:center;gap:8px;background:#5865F2;color:#fff;border-radius:8px;padding:10px 20px;text-decoration:none;font-family:'Cairo',sans-serif;font-weight:600;font-size:.9rem}
</style>
</head>
<body>
<div class="err-card">
  <div class="err-code"><%= title?.includes('404') ? '404' : '⚠' %></div>
  <h1 class="err-title"><%= title || 'خطأ' %></h1>
  <p class="err-msg"><%= message || 'حدث خطأ غير متوقع' %></p>
  <a href="/dashboard" class="btn"><i class="fa-solid fa-house"></i> العودة للرئيسية</a>
</div>
</body>
</html>
